# DeepShield AI - Security Configuration Template
# Copy this file to .env and customize values for production deployment

# Application Secret Key (generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string

# Maximum File Upload Size in Megabytes (recommended: 50)
MAX_FILE_SIZE_MB=50

# Upload storage directory path
UPLOAD_FOLDER=uploads

# Database file location
DATABASE_PATH=deepshield.db

# Enable secure cookies over HTTPS (set to True in production with TLS/HTTPS)
SESSION_COOKIE_SECURE=False

# Abuse prevention rate limits (requests per minute per IP)
UPLOAD_RATE_LIMIT=20
ACTION_RATE_LIMIT=40
